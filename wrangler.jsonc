{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stoich-provisions-orders",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "stoich-provisions-orders-db",
    "database_id": "17a96f43-372f-43ad-882e-5bb3e31df7a8"
  }],
  "vars": {
    "GMAIL_SENDER": "aqlxdetail@gmail.com",
    "INITIAL_NOTIFICATION_EMAIL": "aqlxdetail@gmail.com",
    "STORE_DOMAIN": "aqlx.shop",
    "PICKUP_BOX_LOCATION": "the Stoich Provisions pickup box in front of Unit C7 (behind Deesoniis), 220 East Harmon Industrial",
    "PICKUP_BOX_STEPS": "Press the power button and wait about 30 seconds for the box to fully power up. Then enter your 4-digit code and open the box. Please close the lid after taking your order."
  }
}
