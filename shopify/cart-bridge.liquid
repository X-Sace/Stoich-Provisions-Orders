<div style="margin-top:16px"><button type="button" id="stoich-order-request-button" style="width:100%;padding:14px 18px;border:0;border-radius:10px;background:#111;color:#fff;font-weight:700;cursor:pointer">Continue to order request</button><p id="stoich-order-request-message" style="font-size:13px;color:#666"></p></div>
<script>
(()=>{const btn=document.getElementById('stoich-order-request-button'),msg=document.getElementById('stoich-order-request-message');if(!btn||btn.dataset.bound)return;btn.dataset.bound='1';const WORKER_URL='YOUR_WORKER_URL';btn.addEventListener('click',async()=>{btn.disabled=true;msg.textContent='Loading cart…';try{const r=await fetch('/cart.js',{headers:{Accept:'application/json'}});if(!r.ok)throw Error('Could not read Shopify cart.');const c=await r.json();if(!c.items?.length)throw Error('Your cart is empty.');const snapshot={cart_id:String(c.token||''),currency:c.currency||'USD',items:c.items.map(i=>({product_id:String(i.product_id||''),variant_id:String(i.variant_id||''),title:i.product_title||i.title||'Product',variant:i.variant_title&&i.variant_title!=='Default Title'?i.variant_title:'',sku:i.sku||'',quantity:Number(i.quantity)||1,unit_price_cents:Number(i.price)||0,line_price_cents:Number(i.final_line_price??i.line_price??(i.price*i.quantity))||0}))};sessionStorage.setItem('stoichOrderCart',JSON.stringify(snapshot));location.href=WORKER_URL.replace(/\/$/,'')+'/checkout.html'}catch(e){msg.textContent=e.message||'Could not load cart.';btn.disabled=false}})})();
</script>
